  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0426\u0438\u043A\u043B\u044B \u0432 \u0433\u0440\u0430\u0444\u0435 \u0441\u0445\u043B\u043E\u043F\u044B\u0432\u0430\u044E\u0442\u0441\u044F
    \u0434\u043E \u043E\u0434\u043D\u043E\u0433\u043E \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430,
    \u0430 \u0437\u0430\u0442\u0435\u043C \u043E\u0431\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044E\u0442\u0441\u044F
    \u043F\u043E \u043F\u043E\u0440\u044F\u0434\u043A\u043E\u0432\u043E\u043C\u0443
    \u043D\u043E\u043C\u0435\u0440\u0443, \u0443\u0447\u0442\u0438\u0442\u0435 \u044D\u0442\u043E
    \u043F\u0440\u0438 \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0438
    \u0441\u0432\u043E\u0435\u0433\u043E \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u044F!\n\u041A\u043E\u0433\u0434\u0430
    \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0435, \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435
    \u0441\u043B\u043E\u0442, \u043A\u0443\u0434\u0430 \u043F\u043E\u043C\u0435\u0441\u0442\u0438\u0442\u044C
    \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0435 \u0441\u043B\u0435\u0432\u0430,
    \u0430 \u0437\u0430\u0442\u0435\u043C \u043D\u0430\u0436\u043C\u0438\u0442\u0435
    \u043A\u043D\u043E\u043F\u043A\u0443 \"\u0421\u043E\u0431\u0440\u0430\u0442\u044C
    \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0435\". \u0413\u043E\u0442\u043E\u0432\u044B\u0435
    \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u044F \u043C\u043E\u0436\u043D\u043E
    \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0430\u0442\u044C \u0438\u0437 \u0441\u043B\u043E\u0442\u0430
    \u0432 \u0434\u0440\u0443\u0433\u043E\u0439 \u0441\u043B\u043E\u0442 \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
    \u043C\u044B\u0448\u0438. \u0427\u0442\u043E\u0431\u044B \u0443\u0434\u0430\u043B\u0438\u0442\u044C
    \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0435 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
    \"\u0421\u0431\u0440\u043E\u0441\u0438\u0442\u044C \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0435\"."
